TEST_PASSWORD=your_password_here

# Test Environment
BASE_URL=https://the-internet.herokuapp.com
API_BASE_URL=https://the-internet.herokuapp.com
TEST_TYPE=UI

# Logging
LOG_LEVEL=info

# Execution
DEFAULT_TIMEOUT=30000
SCREENSHOT_ON_FAILURE=false
